# Supabase -> Connect -> "Session pooler" (puerto 5432). Es el que funciona con IPv4 / GitHub Actions.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres


# IA para perfiles y cartas. Recomendado: Gemini (clave solo en el backend).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=120

# Alternativa local: AI_PROVIDER=ollama; ejecutar antes ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b


# Gmail OAuth: conecta la cuenta y selecciona la etiqueta desde Ajustes.
MAIL_MAX_MESSAGES=50
MAIL_MAX_SECONDS=120
MAIL_REPROCESS_REVIEW=false

# Cliente OAuth Web con Gmail API habilitada y permiso gmail.readonly.
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=


# Conexión Google desde Ajustes: cliente OAuth Web + API Gmail habilitada.
# Reutiliza MAIL_OAUTH_CLIENT_ID y MAIL_OAUTH_CLIENT_SECRET de arriba.
# GMAIL_TOKEN_KEY: clave Fernet generada una vez; misma clave en local y Actions.
GMAIL_TOKEN_KEY=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/settings/gmail/callback
